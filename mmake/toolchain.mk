# Scheduling is supplied by mmake at execution time. Keep it out of recipe
# fingerprints: changing -j must not invalidate otherwise identical builds.
RUST_OVERLAY := $(OUT)/rust-std/sysroot-overlay
RUST_TARGET_DIR := $(OUT)/rust-std/target
RUST_TARGET := $(ROOT)/user/targets/x86_64-unknown-mochios.json
RUST_SDK := $(OUT)/newlib-port/sdk
RUST_LINK_FLAGS := -C debuginfo=1 --remap-path-prefix /home/jnix=/build --remap-path-prefix $(ROOT)=/src/mochios -C linker=x86_64-elf-gcc -C link-arg=--sysroot=$(RUST_SDK)/sysroot -C link-arg=-L$(RUST_SDK)/sysroot/lib -C link-arg=-static -C link-arg=-nostdlib -C link-arg=-nostartfiles -C link-arg=-Wl,-T,$(RUST_SDK)/lib/linker.ld -C link-arg=-Wl,-no-pie -C link-arg=-Wl,-z,noexecstack -C link-arg=-Wl,--start-group -C link-arg=$(RUST_SDK)/lib/crt0.o -C link-arg=$(RUST_SDK)/lib/libmochi_user_newlib_runtime.a -C link-arg=-lc -C link-arg=-lm -C link-arg=-lgcc -C link-arg=-Wl,--end-group
CARGO_PATCHES := --config "patch.crates-io.libc.path='$(ROOT)/libraries/libc'" --config "patch.\"https://github.com/mochiOS/libc\".libc.path='$(ROOT)/libraries/libc'" --config "patch.\"https://github.com/mochiOS/mnu\".mnu-abi.path='$(ROOT)/core/crates/abi'" --config "patch.\"https://github.com/mochiOS/mBoot\".mboot-protocol.path='$(ROOT)/services/mboot-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochi-user-platform.path='$(ROOT)/user/crates/platform'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochi-user-syscall.path='$(ROOT)/user/crates/syscall'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-capability-protocol.path='$(ROOT)/user/crates/capability-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-user-database.path='$(ROOT)/user/crates/user-database'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-user-protocol.path='$(ROOT)/user/crates/user-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-viewkit-gpu-protocol.path='$(ROOT)/user/crates/viewkit-gpu-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-virtio-gpu-protocol.path='$(ROOT)/user/crates/virtio-gpu-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-linux-gui-protocol.path='$(ROOT)/user/crates/linux-gui-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-linux-portal-protocol.path='$(ROOT)/user/crates/linux-portal-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-signature-protocol.path='$(ROOT)/user/crates/signature-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-tls-client.path='$(ROOT)/user/crates/tls-client'" --config "patch.crates-io.mochios-mdriver-protocol.path='$(ROOT)/boot/crates/mdriver-protocol'" --config "patch.crates-io.viewkit.path='$(ROOT)/libraries/viewkit'" --config "patch.\"https://github.com/mochiOS/viewkit\".viewkit.path='$(ROOT)/libraries/viewkit'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-net-device-protocol.path='$(ROOT)/user/crates/net-device-protocol'"
CARGO_PATCHES += --config "patch.crates-io.mnu-abi.path='$(ROOT)/core/crates/abi'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/mnu\".mnu.path='$(ROOT)/core'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/mnu\".plugkit.path='$(ROOT)/core/crates/PlugKit/plugkit'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochi-user-runtime.path='$(ROOT)/user/crates/runtime'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-filesystem-protocol.path='$(ROOT)/user/crates/filesystem-protocol'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-workspace-protocol.path='$(ROOT)/user/crates/workspace-protocol'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-posix-protocol.path='$(ROOT)/user/crates/posix-protocol'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-posix-client.path='$(ROOT)/user/crates/posix-client'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-certificate-database.path='$(ROOT)/user/crates/certificate-database'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-elf-signature.path='$(ROOT)/user/crates/elf-signature'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-keychain-protocol.path='$(ROOT)/user/crates/keychain-protocol'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-network-stack.path='$(ROOT)/user/crates/network-stack'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-package-client.path='$(ROOT)/user/crates/package-client'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-package-manifest.path='$(ROOT)/user/crates/package-manifest'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-package-protocol.path='$(ROOT)/user/crates/package-protocol'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-test-support.path='$(ROOT)/user/crates/test-support'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/fonts\".mochios-fonts.path='$(ROOT)/libraries/fonts'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/BootUI\".bootui.path='$(ROOT)/libraries/bootui'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/boot\".mochios-boot-selection.path='$(ROOT)/boot/crates/boot-selection'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/boot\".mochios-mdriver-protocol.path='$(ROOT)/boot/crates/mdriver-protocol'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/boot\".mochios-system-image.path='$(ROOT)/boot/crates/system-image'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/devkit\".mochios-appcore.path='$(ROOT)/tools/devkit/crates/appcore'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/devkit\".mochios-device-consent.path='$(ROOT)/tools/devkit/crates/device-consent'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/devkit\".mochios-file-publication.path='$(ROOT)/tools/devkit/crates/file-publication'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/devkit\".mochios-linker-driver.path='$(ROOT)/tools/devkit/crates/linker-driver'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/services\".ext4plus.path='$(ROOT)/services/third_party/ext4plus'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-certificate.path='$(ROOT)/user/crates/certificate'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-driver-control-protocol.path='$(ROOT)/user/crates/driver-control-protocol'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-http-client.path='$(ROOT)/user/crates/http-client'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-tls-stream-ffi.path='$(ROOT)/user/crates/tls-stream-ffi'"
CARGO_PATCHES += --config "patch.\"https://github.com/mochiOS/syscalls\".mochi-user-newlib-runtime.path='$(ROOT)/user/crates/newlib-runtime'"
MOCHIOS_CARGO := python3 $(ROOT)/user/scripts/cargo-preserve-lock.py --auto -- env CARGO_HOME="${CARGO_HOME:-${HOME}/.cargo}" CARGO_BUILD_JOBS="${MMAKE_JOBS}" RUSTC=$(RUST_OVERLAY)/bin/rustc RUSTDOC=$(RUST_OVERLAY)/bin/rustdoc VIEWKIT_UI_FONT_PATH=$(ROOT)/libraries/fonts/out/fonts/InterVariable.ttf VIEWKIT_MONOSPACE_FONT_PATH=$(ROOT)/libraries/fonts/out/fonts/UDEVGothic-Regular.ttf VIEWKIT_JAPANESE_FONT_PATH=$(ROOT)/libraries/fonts/out/fonts/IBMPlexSansJP-Regular.ttf MOCHIOS_VERSION="${MOCHIOS_VERSION:-26.0.0}" MNU_VERSION="${MNU_VERSION:-0.1.0}" MBOOT_VERSION="${MBOOT_VERSION:-0.1.0}" MOCHIOS_BUILD_NUMBER="${MOCHIOS_BUILD_NUMBER:-0}" MNU_GIT_REVISION="${MNU_GIT_REVISION:-workspace}" MNU_RUSTC_VERSION="${MNU_RUSTC_VERSION:-nightly-2026-07-16}" MNU_BUILD_PROFILE="${MNU_BUILD_PROFILE:-release}" MNU_BUILD_FEATURES="${MNU_BUILD_FEATURES:-kernel-bin}" "RUSTFLAGS=$(RUST_LINK_FLAGS)" $(RUST_OVERLAY)/bin/cargo build --offline -Z build-std=std,panic_abort,compiler_builtins -Z json-target-spec $(CARGO_PATCHES) --release --target $(RUST_TARGET) --target-dir $(RUST_TARGET_DIR)
