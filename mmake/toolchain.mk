MMAKE_CARGO_HOME ?= /mnt/devusb/cargo
RUST_OVERLAY := $(OUT)/rust-std/sysroot-overlay
RUST_TARGET_DIR := $(OUT)/rust-std/target
RUST_TARGET := $(ROOT)/user/targets/x86_64-unknown-mochios.json
RUST_SDK := $(OUT)/newlib-port/sdk
RUST_LINK_FLAGS := --remap-path-prefix /home/jnix=/build --remap-path-prefix $(ROOT)=/src/mochios -C linker=x86_64-elf-gcc -C link-arg=--sysroot=$(RUST_SDK)/sysroot -C link-arg=-L$(RUST_SDK)/sysroot/lib -C link-arg=-static -C link-arg=-nostdlib -C link-arg=-nostartfiles -C link-arg=-Wl,-T,$(RUST_SDK)/lib/linker.ld -C link-arg=-Wl,-no-pie -C link-arg=-Wl,-z,noexecstack -C link-arg=-Wl,--start-group -C link-arg=$(RUST_SDK)/lib/crt0.o -C link-arg=$(RUST_SDK)/lib/libmochi_user_newlib_runtime.a -C link-arg=-lc -C link-arg=-lm -C link-arg=-lgcc -C link-arg=-Wl,--end-group
CARGO_PATCHES := --config "patch.crates-io.libc.path='$(ROOT)/libraries/libc'" --config "patch.\"https://github.com/mochiOS/libc\".libc.path='$(ROOT)/libraries/libc'" --config "patch.crates-io.rustc-std-workspace-alloc.path='$(RUST_OVERLAY)/lib/rustlib/src/rust/library/rustc-std-workspace-alloc'" --config "patch.crates-io.rustc-std-workspace-std.path='$(RUST_OVERLAY)/lib/rustlib/src/rust/library/rustc-std-workspace-std'" --config "patch.\"https://github.com/mochiOS/mnu\".mnu-abi.path='$(ROOT)/core/crates/abi'" --config "patch.\"https://github.com/mochiOS/mBoot\".mboot-protocol.path='$(ROOT)/services/mboot-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochi-user-platform.path='$(ROOT)/user/crates/platform'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochi-user-syscall.path='$(ROOT)/user/crates/syscall'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-user-database.path='$(ROOT)/user/crates/user-database'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-user-protocol.path='$(ROOT)/user/crates/user-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-viewkit-gpu-protocol.path='$(ROOT)/user/crates/viewkit-gpu-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-virtio-gpu-protocol.path='$(ROOT)/user/crates/virtio-gpu-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-linux-gui-protocol.path='$(ROOT)/user/crates/linux-gui-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-linux-portal-protocol.path='$(ROOT)/user/crates/linux-portal-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-signature-protocol.path='$(ROOT)/user/crates/signature-protocol'" --config "patch.\"https://github.com/mochiOS/syscalls\".mochios-tls-client.path='$(ROOT)/user/crates/tls-client'" --config "patch.crates-io.mochios-mdriver-protocol.path='$(ROOT)/boot/crates/mdriver-protocol'" --config "patch.crates-io.viewkit.path='$(ROOT)/libraries/viewkit'" --config "patch.\"https://github.com/mochiOS/viewkit\".viewkit.path='$(ROOT)/libraries/viewkit'"
MOCHIOS_CARGO := env CARGO_HOME=$(MMAKE_CARGO_HOME) CARGO_BUILD_JOBS=$MMAKE_JOBS RUSTC=$(RUST_OVERLAY)/bin/rustc RUSTDOC=$(RUST_OVERLAY)/bin/rustdoc VIEWKIT_UI_FONT_PATH=$(ROOT)/libraries/fonts/out/fonts/InterVariable.ttf VIEWKIT_MONOSPACE_FONT_PATH=$(ROOT)/libraries/fonts/out/fonts/InterVariable.ttf MOCHIOS_VERSION=26.0.0 MNU_VERSION=0.1.0 MBOOT_VERSION=0.1.0 MOCHIOS_BUILD_NUMBER=0 MNU_GIT_REVISION=workspace MNU_RUSTC_VERSION=nightly-2026-07-16 MNU_BUILD_PROFILE=release MNU_BUILD_FEATURES=kernel-bin "RUSTFLAGS=$(RUST_LINK_FLAGS)" $(RUST_OVERLAY)/bin/cargo build --offline -Z build-std=std,panic_abort,compiler_builtins -Z json-target-spec $(CARGO_PATCHES) --release --target $(RUST_TARGET) --target-dir $(RUST_TARGET_DIR)
