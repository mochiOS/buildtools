# mochiOS default build configuration

ARCH_X86_64=y
ENABLE_SMP=y
ENABLE_KPTI=y
ENABLE_ASLR=y
DRIVER_XHCI=y
DRIVER_I8042=y
DRIVER_VIRTIO_NET=y
DEBUG_QEMU_GUI=y
DEBUG_QEMU_DEBUG=n
DEBUG_QEMU_KVM=n
DEBUG_QEMU_CPU=qemu64
DEBUG_QEMU_SMP=2
DEBUG_QEMU_GPU_BACKEND=y
USER_BUILD_SELFTESTS=y
USER_BUILD_MPK_SAMPLES=y
IMAGE_INITFS_SIZE_MB=16
IMAGE_DISK_SIZE_MB=1024
IMAGE_ESP_SIZE_MB=128
KERNEL_RUST_TOOLCHAIN=nightly-2026-05-14
